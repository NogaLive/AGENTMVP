# Proveedor LLM (OpenRouter)
OPENROUTER_API_KEY=tu_openrouter_api_key_aqui

# Persistencia Vectorial (Supabase)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SECRET_KEY=tu_supabase_secret_service_role_key_aqui
SUPABASE_PUBLISHABLE_KEY=tu_supabase_publishable_anon_key_aqui

# Servidor FastMCP (En local: http://127.0.0.1:8001/ ; En Vercel: https://tu-dominio.vercel.app/api/mcp/)
MCP_URL=http://127.0.0.1:8001/

# Entorno de ejecución (development | production)
ENVIRONMENT=development
LOG_LEVEL=INFO
